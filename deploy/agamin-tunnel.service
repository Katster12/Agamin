[Unit]
Description=Cloudflare HTTPS tunnel for Agamin ML API
Wants=network-online.target agamin-ml.service
After=network-online.target agamin-ml.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/agamin_live_deploy
ExecStart=/home/ubuntu/agamin_live_deploy/.venv/bin/python /home/ubuntu/agamin_live_deploy/deploy/tunnel_runner.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
